{
  "name": "gmx-synthetics",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "app": "vite",
    "test": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx hardhat test",
    "prepare": "husky install",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "lint:eslint": "eslint --fix $(git diff --name-only --cached --diff-filter=AM | grep '\\.ts')",
    "lint:prettier": "prettier --write .prettierrc.json $(git diff --name-only --cached --diff-filter=AM | grep '\\.ts')",
    "fork:avalancheFuji": "npx hardhat node --fork https://api.avax-test.network/ext/bc/C/rpc --no-deploy --fork-block-number 16658163",
    "fork:avalanche": "npx hardhat node --fork https://api.avax.network/ext/bc/C/rpc --no-deploy",
    "fork:arbitrum": "npx hardhat node --fork https://arb1.arbitrum.io/rpc --no-deploy",
    "verify:tenderly": "npx hardhat --config hardhat.config.tenderly.ts run scripts/verifyTenderly.ts --network",
    "local:node": "npx hardhat node --no-deploy",
    "local:deploy:base": "SKIP_AUTO_HANDLER_REDEPLOYMENT=true npx hardhat deploy --network localhost --tags Tokens,Router,MockPriceFeed",
    "local:deploy:core": "SKIP_AUTO_HANDLER_REDEPLOYMENT=true npx hardhat deploy --network localhost --tags RoleStore,DataStore,EventEmitter,OrderVault,DepositVault,WithdrawalVault,ShiftVault,ReferralStorage",
    "local:deploy:handlers": "SKIP_AUTO_HANDLER_REDEPLOYMENT=true npx hardhat deploy --network localhost --tags Oracle,OrderHandler,DepositHandler,WithdrawalHandler,ShiftHandler,LiquidationHandler,AdlHandler,ExternalHandler,JitOrderHandler",
    "local:deploy:router": "SKIP_AUTO_HANDLER_REDEPLOYMENT=true npx hardhat deploy --network localhost --tags ExchangeRouter",
    "local:deploy:all": "SKIP_AUTO_HANDLER_REDEPLOYMENT=true npx hardhat deploy --network localhost",
    "local:grant-roles": "npx hardhat run scripts/grantRolesLocal.ts --network localhost",
    "local:set-prices": "npx hardhat run scripts/setMockPrice.ts --network localhost",
    "local:create-market": "npx hardhat run scripts/createLocalMarket.ts --network localhost",
    "local:verify-setup": "npx hardhat run scripts/verifyLocalSetup.ts --network localhost",
    "local:simulate-order": "npx hardhat run scripts/simulateOrder.ts --network localhost",
    "local:configure-markets": "npx hardhat run scripts/configureForexMarkets.ts --network localhost",
    "local:execute-orders": "npx hardhat run scripts/executeOrders.ts --network localhost",
    "local:check-orders": "npx hardhat run scripts/checkPendingOrders.ts --network localhost",
    "local:cancel-all-orders": "npx hardhat run scripts/cancelAllOrders.ts --network localhost",
    "local:add-liquidity": "npx hardhat run scripts/addLiquidity.ts --network localhost",
    "local:execute-deposits": "npx hardhat run scripts/executeDeposits.ts --network localhost",
    "local:remove-liquidity": "npx hardhat run scripts/removeLiquidity.ts --network localhost",
    "local:execute-withdrawals": "npx hardhat run scripts/executeWithdrawals.ts --network localhost",
    "local:cancel-all-deposits": "npx hardhat run scripts/cancelAllDeposits.ts --network localhost",
    "local:debug-deposit": "npx hardhat run scripts/debugDepositExecution.ts --network localhost"
  },
  "author": "",
  "license": "ISC",
