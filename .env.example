# Environment variables should be set using Doppler

# Deployment
HARDHAT_NETWORK=... # baseSepolia
SKIP_AUTO_HANDLER_REDEPLOYMENT=... # boolean
DEPLOY_ON_FORK=... #false

# Wallets
BASE_SEPOLIA_DEPLOYER_ADDRESS=... # deployer address
BASE_SEPOLIA_ACCOUNT_KEY=... # deployer private key
NIVO_KEEPER_ADDRESS=... # nivo keeper address
NIVO_KEEPER_PRIVATE_KEY=... # nivo keeper private key
WALLET_TESTER_ADDRESS=... # wallet tester address
WALLET_TESTER_PRIVATE_KEY=... # wallet tester private key (LP or User)

# API Keys
BASESCAN_API_KEY=... # explorer key
CHAINLINK_CLIENT_ID=... # Chainlink Data Streams client ID
CHAINLINK_CLIENT_SECRET=... # Chainlink Data Streams client secret
CHAINLINK_DATA_STREAM_ENDPOINT=... # Chainlink Data Streams endpoint
CHAINLINK_DATA_STREAM_WS_ENDPOINT=... # Chainlink Data Streams websocket endpoint
CHAINLINK_DATA_STREAM_PROVIDER_ADDRESS=... # Chainlink Data Streams verifier address
SUPABASE_URL=... # Supabase URL
SUPABASE_SERVICE_ROLE_KEY=... # Supabase role key